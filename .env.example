# Required Telegram credentials
API_ID=123456
API_HASH=replace_with_telegram_api_hash
BOT_TOKEN=replace_with_rotated_bot_token

# Required database and administrator configuration
DATABASE_URI=mongodb://localhost:27017
ADMINS=123456789

# Optional database configuration
DATABASE_NAME=booksnew
COLLECTION_NAME=ebookguy
MULTIPLE_DATABASE=false
O_DB_URI=
F_DB_URI=
S_DB_URI=

# Optional Telegram users and channels
AUTH_USERS=
LOG_CHANNEL=0
CHANNELS=
AUTH_CHANNEL=
REQST_CHANNEL=
INDEX_REQ_CHANNEL=0
SUPPORT_CHAT_ID=
DELETE_CHANNELS=

# Public links
GRP_LNK=
CHNL_LNK=
SUPPORT_CHAT=
OWNER_LNK=
PAYMENT_WEBSITE=

# External payment details
PAYPAL_ID=
UPI_ID=
CRYPTO_WALLET=
CRYPTO_TYPE=usdt
BINANCE_PAY_ID=

# Download and premium defaults
FREE_DAILY_LIMIT=2
PREMIUM_DAILY_LIMIT=20
PREMIUM_DOWNLOAD_COOLDOWN=30

# Feature flags
PM_SEARCH=true
AUTO_DELETE=true
BUTTON_MODE=false
MAX_BTN=true
PROTECT_CONTENT=false
PUBLIC_FILE_STORE=false
NO_RESULTS_MSG=true
USE_CAPTION_FILTER=true
FILTER_BY_EXTENSION=true
REQUEST_TO_JOIN_MODE=false
TRY_AGAIN_BTN=false

# Indexed file extensions
EBOOK_EXTENSIONS=epub pdf mobi azw azw3 djvu
AUDIOBOOK_EXTENSIONS=mp3 m4a m4b zip rar 7z

# Runtime
PORT=8080
URL=http://localhost:8080/
PING_INTERVAL=1200
CACHE_TIME=1800
